# Puerto del servidor
PORT=5000

# Conexión a Base de Datos (MongoDB)
# NO pongas tu clave real aquí
MONGODB_URI=mongodb+srv://USER_PLACEHOLDER:PASSWORD_PLACEHOLDER@cluster.mongodb.net/nombre_db

# Clave para firmar tokens (JWT)
JWT_SECRET=clave_secreta_falsa_para_desarrollo

# Clave de la API del Clima (OpenWeather)
WEATHER_API_KEY=api_key_falsa

# URL del Frontend (para CORS)
CLIENT_URL=http://localhost:5173