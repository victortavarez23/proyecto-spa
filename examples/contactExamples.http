@message_id = 694add02dc3515d987aedd1b


### ==========================================
### RUTAS PÚBLICAS (No requieren tokens)
### ==========================================

### Get Contact Info
GET {{baseUrl}}/contact/info

### Submit Contact Message (Enviar mensaje nuevo)
# @name createMessage
POST {{baseUrl}}/contact/submit
Content-Type: {{contentType}}

{
  "name": "María García",
  "email": "maria@example.com",
  "phone": "+34 612 345 678",
  "subject": "Consulta sobre productos",
  "message": "Hola, me gustaría obtener más información sobre los productos premium.",
  "category": "sales"
}


### ==========================================
### RUTAS ADMINISTRATIVAS (Requieren token)
### ==========================================

### Get Contact Messages (Listar todos)
GET {{baseUrl}}/contact/messages?page=1&limit=10
Authorization: Bearer {{admin_token}}

### Get Contact Stats (Estadísticas)
GET {{baseUrl}}/contact/stats
Authorization: Bearer {{admin_token}}

### Get Specific Message (Ver uno solo usando la variable message_id)
GET {{baseUrl}}/contact/messages/{{message_id}}
Authorization: Bearer {{admin_token}}

### Update Message Status (Cambiar estado)
PUT {{baseUrl}}/contact/messages/{{message_id}}/status
Authorization: Bearer {{admin_token}}
Content-Type: {{contentType}}

{
  "status": "in_progress",
  "priority": "high"
}

### Respond to Message (Responder)
POST {{baseUrl}}/contact/messages/{{message_id}}/respond
Authorization: Bearer {{admin_token}}
Content-Type: {{contentType}}

{
  "responseMessage": "Hola María, gracias por tu consulta. Te contactaremos pronto."
}

### Delete Message (Eliminar)
DELETE {{baseUrl}}/contact/messages/{{message_id}}
Authorization: Bearer {{admin_token}}